# ===== 大模型 API 密钥 =====
# 复制此文件为 .env 并填入真实的 Key
# 切记：.env 已被 .gitignore 忽略，不要提交到 GitHub

# 阿里云百炼 / 通义千问（推荐，有免费额度）
# 获取地址：https://bailian.console.aliyun.com/
# 步骤：登录 → API-KEY 管理 → 创建 API-KEY → 复制 sk- 开头的密钥
DASHSCOPE_API_KEY=

# ===== 其他可选服务商 =====

# DeepSeek https://platform.deepseek.com
DEEPSEEK_API_KEY=

# 智谱 AI（GLM-4-Flash 免费）https://open.bigmodel.cn
ZHIPU_API_KEY=

# 硅基流动（聚合平台，部分模型免费）https://siliconflow.cn
SILICONFLOW_API_KEY=

# ===== 访问控制 =====

# 设置后打开网页需要输入密码（公网分享时强烈建议设置）
# 留空则不验证
ACCESS_PASSWORD=

# ===== 可选：可观测性 =====

# LangSmith 追踪 https://smith.langchain.com
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=ai-agent
